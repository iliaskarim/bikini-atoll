{
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "include": "./cursor-dark-color-theme.json",
  "colors": {
    "editor.foreground": "#dadada",
    "editorLineNumber.activeForeground": "#dadada",
    "terminal.background": "#000000",
    "terminal.foreground": "#555555",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#555555",
    "terminal.ansiGreen": "#555555",
    "terminal.ansiYellow": "#555555",
    "terminal.ansiBlue": "#555555",
    "terminal.ansiMagenta": "#555555",
    "terminal.ansiCyan": "#555555",
    "terminal.ansiWhite": "#555555",
    "terminal.ansiBrightBlack": "#555555",
    "terminal.ansiBrightRed": "#555555",
    "terminal.ansiBrightGreen": "#555555",
    "terminal.ansiBrightYellow": "#555555",
    "terminal.ansiBrightBlue": "#555555",
    "terminal.ansiBrightMagenta": "#555555",
    "terminal.ansiBrightCyan": "#555555",
    "terminal.ansiBrightWhite": "#555555",
    "terminal.selectionBackground": "#555555",
    "terminal.selectionForeground": "#000000",
    "terminalCursor.foreground": "#555555",
    "symbolIcon.arrayForeground": "#dadada",
    "symbolIcon.booleanForeground": "#dadada",
    "symbolIcon.classForeground": "#dadada",
    "symbolIcon.colorForeground": "#dadada",
    "symbolIcon.constantForeground": "#dadada",
    "symbolIcon.constructorForeground": "#dadada",
    "symbolIcon.enumeratorForeground": "#dadada",
    "symbolIcon.enumeratorMemberForeground": "#dadada",
    "symbolIcon.eventForeground": "#dadada",
    "symbolIcon.fieldForeground": "#dadada",
    "symbolIcon.fileForeground": "#dadada",
    "symbolIcon.folderForeground": "#dadada",
    "symbolIcon.functionForeground": "#dadada",
    "symbolIcon.interfaceForeground": "#dadada",
    "symbolIcon.keyForeground": "#dadada",
    "symbolIcon.keywordForeground": "#dadada",
    "symbolIcon.methodForeground": "#dadada",
    "symbolIcon.moduleForeground": "#dadada",
    "symbolIcon.namespaceForeground": "#dadada",
    "symbolIcon.nullForeground": "#dadada",
    "symbolIcon.numberForeground": "#dadada",
    "symbolIcon.objectForeground": "#dadada",
    "symbolIcon.operatorForeground": "#dadada",
    "symbolIcon.packageForeground": "#dadada",
    "symbolIcon.propertyForeground": "#dadada",
    "symbolIcon.referenceForeground": "#dadada",
    "symbolIcon.snippetForeground": "#dadada",
    "symbolIcon.stringForeground": "#dadada",
    "symbolIcon.structForeground": "#dadada",
    "symbolIcon.textForeground": "#dadada",
    "symbolIcon.typeParameterForeground": "#dadada",
    "symbolIcon.unitForeground": "#dadada",
    "symbolIcon.variableForeground": "#dadada",
    "breadcrumb.foreground": "#dadada",
    "breadcrumb.focusForeground": "#dadada",
    "breadcrumb.activeSelectionForeground": "#dadada",
    "breadcrumb.background": "#181818",
    "editorBracketMatch.background": "#ffffff28",
    "editorBracketMatch.border": "#dadada",
    "list.highlightForeground": "#dadada",
    "editorSuggestWidget.highlightForeground": "#dadada",
    "editor.wordHighlightBackground": "#00000000",
    "editor.wordHighlightStrongBackground": "#00000000",
    "editor.selectionHighlightBackground": "#40404066"
  },
  "semanticHighlighting": false,
  "semanticTokenColors": {
    "*": "#dadada",
    "namespace": "#dadada",
    "type": "#dadada",
    "class": "#dadada",
    "enum": "#dadada",
    "interface": "#dadada",
    "struct": "#dadada",
    "typeParameter": "#dadada",
    "parameter": "#dadada",
    "variable": "#dadada",
    "property": "#dadada",
    "enumMember": "#dadada",
    "event": "#dadada",
    "function": "#dadada",
    "method": "#dadada",
    "macro": "#dadada",
    "label": "#dadada",
    "comment": "#dadada",
    "string": "#dadada",
    "keyword": "#dadada",
    "number": "#dadada",
    "regexp": "#dadada",
    "operator": "#dadada"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "Flatten all TextMate scopes (override Dark+ defaults)",
      "scope": [
        "comment",
        "comment.block",
        "comment.line",
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "keyword",
        "keyword.control",
        "keyword.operator",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable",
        "variable.other",
        "variable.parameter",
        "variable.language",
        "variable.function",
        "entity",
        "entity.name",
        "entity.name.function",
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.tag",
        "entity.name.section",
        "entity.other.attribute-name",
        "entity.other.inherited-class",
        "support",
        "support.function",
        "support.class",
        "support.type",
        "support.constant",
        "support.variable",
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta",
        "meta.function",
        "meta.function-call",
        "meta.class",
        "meta.import",
        "meta.type",
        "meta.interface",
        "meta.var",
        "meta.definition",
        "invalid",
        "invalid.illegal",
        "invalid.deprecated",
        "markup",
        "source"
      ],
      "settings": {
        "foreground": "#dadada",
        "fontStyle": ""
      }
    }
  ]
}
